# ===============================================================================
# Crontab del host para jobs batch de la Fase 1
# Instalar con: bash cron/setup_cron.sh  (o copiar manualmente a crontab -e)
# IMPORTANTE: ajustar la ruta del proyecto en setup_cron.sh
# ===============================================================================

# Reporte diario de producción -> landing/produccion_diaria/
0 3 * * * cd /ruta/proyecto && /usr/bin/python3 generators/daily_production_csv.py >> /ruta/proyecto/logs/batch.log 2>&1

# Análisis de laboratorio diario -> landing/laboratorio/
15 3 * * * cd /ruta/proyecto && /usr/bin/python3 generators/daily_lab_csv.py >> /ruta/proyecto/logs/batch.log 2>&1

# Extracción OLTP -> raw/oltp/
30 3 * * * cd /ruta/proyecto && /usr/bin/python3 ingestion/extract_oltp.py >> /ruta/proyecto/logs/batch.log 2>&1

# Sincronizar cuencas/pozos OLTP -> TimescaleDB (maestros de trabajo, Fase 2)
45 3 * * * cd /ruta/proyecto && /usr/bin/python3 generators/seed_tsdb.py >> /ruta/proyecto/logs/batch.log 2>&1

# Cargar landing/raw de MinIO -> esquema raw en TimescaleDB (Fase 3, insumo de dbt)
55 3 * * * cd /ruta/proyecto && /usr/bin/python3 ingestion/load_landing_to_raw.py >> /ruta/proyecto/logs/batch.log 2>&1

# Precios WTI/Brent -> raw/precios/
0 6 * * * cd /ruta/proyecto && /usr/bin/python3 generators/fetch_prices.py >> /ruta/proyecto/logs/batch.log 2>&1

# Cargar precios de MinIO -> raw.precios (Fase 3)
5 6 * * * cd /ruta/proyecto && /usr/bin/python3 ingestion/load_landing_to_raw.py --tables precios >> /ruta/proyecto/logs/batch.log 2>&1

# Logs SCADA -> raw/logs_scada/ (cada hora, más frecuencia de eventos)
0 * * * * cd /ruta/proyecto && /usr/bin/python3 generators/scada_logs.py >> /ruta/proyecto/logs/batch.log 2>&1