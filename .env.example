# ===============================================================================
# Variables de entorno - MONITOREO IOT DE POZOS Y MANTENIMIENTO PREDICTIVO
# Copiar a .env y ajustar los valores antes de `docker compose up`
# ===============================================================================

# --- Mosquitto (MQTT Broker) ---
MOSQUITTO_PORT=1883
MOSQUITTO_WS_PORT=9001

# --- TimescaleDB (Time-Series DB) ---
TSDB_POSTGRES_USER=tsdb
TSDB_POSTGRES_PASSWORD=change_me_tsdb
TSDB_POSTGRES_DB=oil_tsdb
TSDB_PORT=5432

# --- MinIO (S3 local) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=oil-lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_PORT=3000

# --- Apache Superset (Fase 4, item 4.2) ---
SUPERSET_VERSION=5.0.0
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset
SUPERSET_ADMIN_EMAIL=admin@oilgas.local
# Generar con: openssl rand -base64 42
SUPERSET_SECRET_KEY=change_me_superset_secret_key

# --- Postgres OLTP (ERP/CMMS) ---
OLTP_POSTGRES_USER=oltp
OLTP_POSTGRES_PASSWORD=change_me_oltp
OLTP_POSTGRES_DB=cmms
OLTP_PORT=5433

# ===============================================================================
# Fase 1 - Conexiones de los scripts Python (host -> contenedores)
# ===============================================================================

# --- MQTT ---
MQTT_BROKER_URL=mqtt://localhost:1883

# --- TimescaleDB ---
TIMESDB_DB_URL=postgresql://tsdb:change_me_tsdb@localhost:5432/oil_tsdb

# --- MinIO (S3 local) ---
MINIO_BUCKET=oil-lakehouse
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio

# --- Postgres OLTP (ERP/CMMS) ---
OLTP_DB_URL=postgresql://oltp:change_me_oltp@localhost:5433/cmms

# --- API de precios (mock FastAPI propio) ---
PRICES_API_URL=http://localhost:8001/api/precios

# --- API de pozos (Fase 4) ---
API_PORT=8000
API_KEY=change_me_api_key

# --- Simulador de sensores: comportamiento ---
SENSOR_INTERVAL_SEC=2
SENSOR_OUT_OF_ORDER_PROB=0.15
SENSOR_LOSS_PROB=0.05
SENSOR_DELAY_PROB=0.15